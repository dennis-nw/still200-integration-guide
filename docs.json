{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Still200",
  "description": "Monitor HTTP services and scheduled jobs with Still200.",
  "colors": {
    "primary": "#059669",
    "light": "#059669",
    "dark": "#34d399"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/favicon.svg",
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "light"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.still200.com"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "HTTP monitoring",
        "pages": [
          "http-monitoring/overview",
          "http-monitoring/health-check-spec",
          "http-monitoring/examples",
          "http-monitoring/failure-semantics"
        ]
      },
      {
        "group": "Scheduled jobs",
        "pages": [
          "scheduled-jobs/overview",
          "scheduled-jobs/configure",
          "scheduled-jobs/report-runs",
          "scheduled-jobs/statuses",
          "scheduled-jobs/examples"
        ]
      },
      {
        "group": "Help",
        "pages": ["troubleshooting"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/dennis-nw/still200-integration-guide"
    }
  }
}
